---
// A lightweight, dependency-free image carousel: fixed aspect-ratio viewport,
// autoplay with pause-on-hover/focus, prev/next buttons, and dot navigation.
// Pass real images (ImageMetadata) or omit `image` to render a placeholder
// slide (useful until real photos are supplied).
import { Image } from "astro:assets";

interface Slide {
  image?: ImageMetadata;
  alt: string;
  // "contain" shows the whole frame (use for portrait shots); "cover" crops to fill.
  fit?: "cover" | "contain";
  // Focal point used when the slide is cropped, e.g. "center 30%".
  position?: string;
}

interface Props {
  slides: Slide[];
  // Aspect ratio of the carousel viewport, e.g. "4 / 3" or "16 / 9".
  ratio?: string;
  // Rendered width of the carousel, used to pick the right image size.
  sizes?: string;
}

const { slides, ratio = "16 / 9", sizes = "(max-width: 720px) 100vw, 50vw" } = Astro.props;
---

<section
  class="carousel"
  style={`--carousel-ratio: ${ratio};`}
  aria-roledescription="karusell"
  aria-label="Bilder fra klubben"
>
  <div class="carousel-track" id="carousel-track">
    {slides.map((slide) => (
      <figure
        class="carousel-slide"
        style={`--slide-fit: ${slide.fit ?? "cover"}; --slide-position: ${slide.position ?? "center"};`}
      >
        {slide.image ? (
          <Image
            src={slide.image}
            alt={slide.alt}
            widths={[400, 640, 960, 1280, 1536]}
            sizes={sizes}
          />
        ) : (
          <div class="carousel-placeholder">{slide.alt}</div>
        )}
      </figure>
    ))}
  </div>

  {slides.length > 1 && (
    <>
      <button class="carousel-btn carousel-prev" type="button" aria-label="Forrige bilde">‹</button>
      <button class="carousel-btn carousel-next" type="button" aria-label="Neste bilde">›</button>
      <div class="carousel-dots" role="tablist" aria-label="Velg bilde">
        {slides.map((_, i) => (
          <button
            class="carousel-dot"
            type="button"
            role="tab"
            data-index={i}
            aria-label={`Gå til bilde ${i + 1}`}
            aria-selected={i === 0 ? "true" : "false"}
          />
        ))}
      </div>
    </>
  )}
</section>

<style>
  .carousel {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: var(--carousel-ratio, 16 / 9);
    background: var(--color-surface);
  }

  .carousel-track {
    display: flex;
    height: 100%;
    transition: transform 0.6s ease;
  }

  .carousel-slide {
    flex: 0 0 100%;
    height: 100%;
    margin: 0;
  }

  .carousel-slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: var(--slide-fit, cover);
    object-position: var(--slide-position, center);
    display: block;
  }

  .carousel-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    font-size: 1rem;
    text-align: center;
    padding-inline: 1rem;
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: clamp(32px, 8vw, 40px);
    height: clamp(32px, 8vw, 40px);
    border: none;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.4);
    color: #fff;
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-btn:hover {
    background: rgba(0, 0, 0, 0.6);
  }

  .carousel-prev {
    left: 0.75rem;
  }

  .carousel-next {
    right: 0.75rem;
  }

  .carousel-dots {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    translate: -50% 0;
    display: flex;
    gap: 0.5rem;
  }

  .carousel-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    border: none;
    background: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    padding: 0;
  }

  .carousel-dot[aria-selected="true"] {
    background: #fff;
  }
</style>

<script>
  // Runs on every Astro page (including client-side transitions), so we
  // re-query and re-bind each time astro:page-load fires.
  function initCarousels() {
    document.querySelectorAll<HTMLElement>(".carousel").forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>(".carousel-track");
      const slides = carousel.querySelectorAll<HTMLElement>(".carousel-slide");
      const dots = carousel.querySelectorAll<HTMLButtonElement>(".carousel-dot");
      const prevBtn = carousel.querySelector<HTMLButtonElement>(".carousel-prev");
      const nextBtn = carousel.querySelector<HTMLButtonElement>(".carousel-next");
      if (!track || slides.length <= 1) return;

      let index = 0;
      let timer: ReturnType<typeof setInterval> | undefined;
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function goTo(next: number) {
        index = (next + slides.length) % slides.length;
        track!.style.transform = `translateX(-${index * 100}%)`;
        dots.forEach((dot, i) => dot.setAttribute("aria-selected", String(i === index)));
      }

      function start() {
        if (prefersReducedMotion) return;
        stop();
        timer = setInterval(() => goTo(index + 1), 6000);
      }

      function stop() {
        if (timer) clearInterval(timer);
      }

      prevBtn?.addEventListener("click", () => { goTo(index - 1); start(); });
      nextBtn?.addEventListener("click", () => { goTo(index + 1); start(); });
      dots.forEach((dot, i) => dot.addEventListener("click", () => { goTo(i); start(); }));

      carousel.addEventListener("mouseenter", stop);
      carousel.addEventListener("mouseleave", start);
      carousel.addEventListener("focusin", stop);
      carousel.addEventListener("focusout", start);

      start();
    });
  }

  initCarousels();
  document.addEventListener("astro:page-load", initCarousels);
</script>
