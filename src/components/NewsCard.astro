---
// Image-led news card: illustration (or a category icon placeholder),
// a category pill overlaid on the image, and the post title underneath.
import { Image } from "astro:assets";

interface Props {
  href: string;
  title: string;
  date: Date;
  category?: string;
  image?: ImageMetadata;
  /** Renders larger, spanning the full grid width - used for the single
   * most recent article so it's the first thing readers' eyes land on. */
  featured?: boolean;
}

const { href, title, date, category, image, featured = false } = Astro.props;

// Simple line-icon placeholders per category, used until real photos are
// added. Falls back to a newspaper icon for uncategorised posts.
const ICONS: Record<string, string> = {
  skytebane: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>',
  årsmøte: '<path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  vaktliste: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/>',
  medlemsfordel: '<path d="M20.59 13.41 13 21a2 2 0 0 1-2.83 0L3 13.83a2 2 0 0 1 0-2.83L10.59 3H19a2 2 0 0 1 2 2v8.41z"/><circle cx="14.5" cy="8.5" r="1.5"/>',
  stevne: '<circle cx="12" cy="8" r="6"/><path d="M9.5 13.5 7 22l5-3 5 3-2.5-8.5"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 16v-5M12 8h.01"/>',
};
const DEFAULT_ICON = '<path d="M4 4h13a3 3 0 0 1 3 3v13H7a3 3 0 0 1-3-3V4z"/><path d="M16 8h2M16 12h2M16 16h2M8 8h4v4H8z"/>';

const slug = (category ?? "").toLowerCase();
const icon = ICONS[slug] ?? DEFAULT_ICON;
---

<article class:list={["news-card", { "news-card-featured": featured }]}>
  <a href={href} class="news-card-media">
    {image ? (
      <Image src={image} alt="" width={featured ? 960 : 640} />
    ) : (
      <span class={`news-card-placeholder cat-${slug || "default"}`} aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
      </span>
    )}
    {category && <span class="news-card-tag">{category}</span>}
  </a>
  <h3><a href={href}>{title}</a></h3>
  <p class="news-card-date">
    {date.toLocaleDateString("no-NO", { day: "numeric", month: "long", year: "numeric" })}
  </p>
</article>
