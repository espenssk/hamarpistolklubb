---
import Layout from "../../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
---

<Layout title="Takk">
  <h1>Takk for din henvendelse!</h1>
  <p class="lead">
    Meldingen din er sendt. Vi svarer deg på e-post eller telefon så snart
    vi kan.
  </p>
  <p><a class="button" href={base}>Tilbake til forsiden</a></p>
</Layout>
