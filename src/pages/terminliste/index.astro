---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { buildICS } from "../../utils/ics";

const events = (await getCollection("terminliste")).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
);

const links = [
  {
    href: "https://www.skyting.no/pistol/terminliste-pistol-2/",
    label: "Terminliste hos NSF",
    description: "Alle approberte pistolstevner i Norge.",
  },
  {
    href: "https://app.skyting.no/",
    label: "SkytterAdmin",
    description: "Startkort, påmelding til stevner og resultater.",
  },
  {
    href: "https://app.rubic.no/",
    label: "RUBIC",
    description: "Medlemskap, kontingent og egne medlemsopplysninger.",
  },
];
---

<Layout title="Terminliste" description="Terminliste for klubbarrangementer og lenker til NSFs terminliste, SkytterAdmin og RUBIC.">
  <h1>Terminliste</h1>
  <p class="lead">
    Her finner du klubbens egne arrangementer. Stevner utenfor klubben,
    påmelding og medlemsopplysninger administreres i Skytterforbundets
    systemer:
  </p>

  <ul class="link-cards">
    {links.map((link) => (
      <li>
        <a href={link.href} target="_blank" rel="noopener">
          {link.label}<span class="sr-only"> (åpnes i ny fane)</span>
        </a>
        <span>{link.description}</span>
      </li>
    ))}
  </ul>

  {events.length > 0 && (
    <>
      <h2>Klubbarrangementer</h2>

      <div class="field">
        <label for="event-search">Søk i klubbarrangementer</label>
        <input
          id="event-search"
          type="search"
          placeholder="Søk på navn eller sted…"
          autocomplete="off"
        />
      </div>

      <table id="events-table">
        <thead>
          <tr>
            <th>Dato</th>
            <th>Arrangement</th>
            <th>Sted</th>
            <th><span class="sr-only">Kalender</span></th>
          </tr>
        </thead>
        <tbody>
          {events.map((event) => (
            <tr data-search={`${event.data.title} ${event.data.location ?? ""}`.toLowerCase()}>
              <td data-label="Dato">{event.data.date.toLocaleDateString("no-NO")}</td>
              <td data-label="Arrangement">{event.data.title}</td>
              <td data-label="Sted">{event.data.location ?? "—"}</td>
              <td>
                <a
                  class="ics-link"
                  href={buildICS(event)}
                  download={`${event.id}.ics`}
                >
                  +&nbsp;Kalender
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="lead" id="no-results" hidden>Ingen arrangementer matcher søket.</p>
      <p class="sr-only" id="search-status" role="status" aria-live="polite"></p>
    </>
  )}
</Layout>

<style>
  .link-cards {
    list-style: none;
    padding: 0;
    margin-block: 1.25rem 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .link-cards li {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: 0.9rem 1rem;
  }

  .link-cards a {
    font-weight: 600;
  }

  /* Direct child only, so the nested .sr-only span keeps its own styles. */
  .link-cards > li > span {
    display: block;
    margin-top: 0.2rem;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .field {
    margin-bottom: 1rem;
    max-width: 24rem;
  }

  .field label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.3rem;
    font-size: 0.95rem;
  }

  #event-search {
    width: 100%;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font: inherit;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .ics-link {
    white-space: nowrap;
    font-size: 0.9rem;
  }

  /* Below 720px there isn't room for 4 real columns without squeezing
     "Arrangement"/"Sted" so tight that long words like "Ankerskogen"
     get broken mid-word. Instead, each row becomes a card and each
     cell becomes a labelled block (label from the data-label attribute),
     stacked full-width so nothing needs to wrap awkwardly. */
  @media (max-width: 720px) {
    #events-table {
      font-size: 0.95rem;
    }

    #events-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    #events-table,
    #events-table tbody,
    #events-table tr,
    #events-table td {
      display: block;
      width: 100%;
    }

    #events-table tr {
      margin-bottom: 0.9rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: 0.75rem 0.9rem;
    }

    #events-table tr:last-child {
      margin-bottom: 0;
    }

    #events-table td {
      padding: 0.3rem 0;
      border-bottom: none;
      overflow-wrap: break-word;
    }

    #events-table td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      color: var(--color-muted);
      margin-bottom: 0.1rem;
    }

    #events-table td:last-child {
      padding-top: 0.5rem;
    }

    .ics-link {
      font-size: 0.9rem;
    }
  }
</style>

<script>
  const input = document.getElementById("event-search") as HTMLInputElement | null;
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>("#events-table tbody tr"));
  const noResults = document.getElementById("no-results");
  const searchStatus = document.getElementById("search-status");

  input?.addEventListener("input", () => {
    const query = input.value.trim().toLowerCase();
    let visibleCount = 0;

    for (const row of rows) {
      const matches = !query || (row.dataset.search ?? "").includes(query);
      row.hidden = !matches;
      if (matches) visibleCount += 1;
    }

    if (noResults) noResults.hidden = visibleCount !== 0;
    if (searchStatus) {
      searchStatus.textContent = query
        ? `${visibleCount} ${visibleCount === 1 ? "arrangement" : "arrangementer"} funnet.`
        : "";
    }
  });
</script>
