---
import Layout from "../layouts/Layout.astro";
import Carousel from "../components/Carousel.astro";
import electronicTargetCrop from "../assets/images/electronic_target_crop.jpg";
import indoorsRange2 from "../assets/images/indoors_range_2.jpeg";
import indoorsRange3 from "../assets/images/indoors_range_3.jpeg";

const times = [
  { day: "Tirsdag", hours: "18:00 – 20:30", note: "Innslipp kl. 18:00 og 19:00" },
  { day: "Lørdag", hours: "13:00 – 16:30", note: "Innslipp kl. 13:00 og 14:00" },
];

const slides = [
  { image: indoorsRange2, alt: "Innendørsbanen på Ankerskogen" },
  // Near-square crop: show the whole frame instead of cropping it further.
  { image: electronicTargetCrop, alt: "Elektroniske skiver på standplass", fit: "contain" as const },
  { image: indoorsRange3, alt: "Innendørsbanen på Ankerskogen" },
];
---

<Layout title="Skytebane" description="Åpningstider og fasiliteter på Hamar Pistolklubbs innendørsbane i Ankerskogen svømmehall.">
  <h1>Ankerskogen, Hamar</h1>

  <p class="lead">
    Vår innendørsbane ligger i kjelleren på Ankerskogen svømmehall. Banen har
    10 standplasser med både pappskiver og elektroniske skiver fra
    Megalink, samt 10 elektroniske skiver for luftpistol. Vi skyter med
    kaliber fra 22LR til 38 Spesial, fra september til slutten av april.
  </p>

  <table>
    <caption class="sr-only">Treningstider på Ankerskogen</caption>
    <thead>
      <tr>
        <th>Dag</th>
        <th>Treningstid</th>
        <th>Merknad</th>
      </tr>
    </thead>
    <tbody>
      {times.map((t) => (
        <tr>
          <td>{t.day}</td>
          <td>{t.hours}</td>
          <td>{t.note}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <div class="split">
    <div class="split-carousel">
      <Carousel slides={slides} ratio="4 / 3" sizes="(max-width: 720px) 100vw, 472px" />
    </div>
    <div class="map-embed">
      <iframe
        title="Kart til Ankerskogen svømmehall"
        src="https://www.google.com/maps?q=Ankerskogen+sv%C3%B8mmehall,+Hamar&output=embed"
        width="100%"
        height="100%"
        style="border:0;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</Layout>

