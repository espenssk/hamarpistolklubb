---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("nyheter")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const recentPosts = posts.slice(0, 5);

// Unique categories, in the order they first appear among the newest posts.
const categories = [...new Set(posts.map((p) => p.data.category).filter(Boolean))] as string[];

// Group posts by year-month for the "Arkiv" widget, e.g. key "2026-03",
// label "mars 2026" - newest first.
const archiveFormatter = new Intl.DateTimeFormat("no-NO", { month: "long", year: "numeric" });
const archiveMap = new Map<string, string>();
for (const post of posts) {
  const d = post.data.date;
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
  if (!archiveMap.has(key)) archiveMap.set(key, archiveFormatter.format(d));
}
const archive = [...archiveMap.entries()]
  .sort((a, b) => (a[0] < b[0] ? 1 : -1))
  .map(([key, label]) => ({ key, label }));
---

<Layout title="Nyheter" description="Siste nytt fra Hamar Pistolklubb.">
  <h1>Nyheter</h1>

  <div class="nyheter-layout">
    <div class="nyheter-list" id="nyheter-list">
      <p class="lead filter-status" id="filter-status" hidden></p>
      {posts.length === 0 && <p class="lead">Ingen nyheter enda.</p>}
      {posts.map((post) => {
        const d = post.data.date;
        const yearMonth = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
        return (
          <div
            class="card nyheter-item"
            data-category={post.data.category ?? ""}
            data-archive={yearMonth}
          >
            <h2><a href={`/nyheter/${post.id}`}>{post.data.title}</a></h2>
            <p class="lead">
              {post.data.date.toLocaleDateString("no-NO")}
              {post.data.summary ? ` · ${post.data.summary}` : ""}
            </p>
          </div>
        );
      })}
    </div>

    <aside class="nyheter-sidebar" aria-label="Nyheter - filtrering og oversikt">
      <section class="sidebar-widget">
        <h2>Nyeste innlegg</h2>
        <ul>
          {recentPosts.map((post) => (
            <li>
              <a href={`/nyheter/${post.id}`}>{post.data.title}</a>
              <span class="widget-date">
                {post.data.date.toLocaleDateString("no-NO", { day: "numeric", month: "long", year: "numeric" })}
              </span>
            </li>
          ))}
        </ul>
      </section>

      {categories.length > 0 && (
        <section class="sidebar-widget">
          <h2>Kategorier</h2>
          <ul>
            {categories.map((category) => (
              <li>
                <a href={`?kategori=${encodeURIComponent(category)}`} data-filter-category={category}>
                  {category}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {archive.length > 0 && (
        <section class="sidebar-widget">
          <h2>Arkiv</h2>
          <ul>
            {archive.map((entry) => (
              <li>
                <a href={`?arkiv=${entry.key}`} data-filter-archive={entry.key}>
                  {entry.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </aside>
  </div>
</Layout>

<style>
  .nyheter-layout {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(220px, 1fr);
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
  }

  .nyheter-list > .card + .card {
    margin-top: 1rem;
  }

  .filter-status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1rem;
  }

  .filter-status a {
    font-weight: 600;
  }

  .sidebar-widget {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: clamp(1rem, 2.5vw, 1.25rem);
  }

  .sidebar-widget + .sidebar-widget {
    margin-top: 1.25rem;
  }

  .sidebar-widget h2 {
    margin: 0 0 0.75rem;
  }

  .sidebar-widget ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .sidebar-widget li {
    display: flex;
    flex-direction: column;
  }

  .sidebar-widget a {
    text-decoration: none;
  }

  .sidebar-widget a:hover {
    text-decoration: underline;
  }

  .sidebar-widget a.is-active {
    font-weight: 700;
    color: var(--color-primary-dark);
  }

  .widget-date {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .nyheter-layout {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Client-side filtering by category/archive month via URL query params
  // (?kategori=X / ?arkiv=YYYY-MM) - works on a static export since there's
  // no server involved, just show/hide the already-rendered cards.
  function applyFilter() {
    const params = new URLSearchParams(window.location.search);
    const category = params.get("kategori");
    const archive = params.get("arkiv");

    const items = document.querySelectorAll<HTMLElement>(".nyheter-item");
    let visibleCount = 0;
    items.forEach((item) => {
      const matchesCategory = !category || item.dataset.category === category;
      const matchesArchive = !archive || item.dataset.archive === archive;
      const visible = matchesCategory && matchesArchive;
      item.hidden = !visible;
      if (visible) visibleCount++;
    });

    document.querySelectorAll<HTMLAnchorElement>("[data-filter-category], [data-filter-archive]").forEach((link) => {
      const isActive =
        (link.dataset.filterCategory && link.dataset.filterCategory === category) ||
        (link.dataset.filterArchive && link.dataset.filterArchive === archive);
      link.classList.toggle("is-active", Boolean(isActive));
    });

    const status = document.getElementById("filter-status");
    if (status) {
      if (category || archive) {
        // Built with DOM APIs (not innerHTML + template string) so an
        // attacker-controlled ?kategori=/?arkiv= value can never be
        // interpreted as HTML - it's always inserted as plain text.
        status.replaceChildren();
        status.append(`Viser ${visibleCount} innlegg`);
        if (category) {
          status.append(" i «", category, "»");
        }
        status.append(". ");
        const link = document.createElement("a");
        link.href = "/nyheter";
        link.textContent = "Vis alle innlegg";
        status.append(link);
        status.hidden = false;
      } else {
        status.hidden = true;
      }
    }
  }

  applyFilter();
  document.addEventListener("astro:page-load", applyFilter);
</script>
