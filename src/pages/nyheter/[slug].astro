---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("nyheter");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<"nyheter"> };
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
---

<Layout title={post.data.title} description={post.data.summary}>
  <p class="back-link"><a href={`${base}nyheter`}>&larr; Tilbake til nyheter</a></p>
  <p class="lead">{post.data.date.toLocaleDateString("no-NO")}</p>
  <h1>{post.data.title}</h1>
  <Content />
</Layout>

<style>
  .back-link {
    margin: 0 0 1rem;
  }

  .back-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .back-link a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>
