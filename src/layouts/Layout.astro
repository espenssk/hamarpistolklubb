---
import "../styles/global.css";
import { Image } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import logoHorizontal from "../assets/images/logo-horizontal.svg";
import { sponsors } from "../data/sponsors";

interface Props {
  title: string;
  description?: string;
  /** Path to a social preview image, relative to /public (defaults to the logo). */
  ogImage?: string;
  /** Hide the global footer sponsor strip, e.g. when a page shows its own sponsor section. */
  hideSponsorStrip?: boolean;
}

const {
  title,
  description = "Hamar Pistolklubb – bane, terminliste og informasjon.",
  ogImage = "/images/logo.png",
  hideSponsorStrip = false,
} = Astro.props;

// BASE_URL always ends with "/" (e.g. "/" or "/hps-homepage/"). withBase()
// turns a root-relative path like "/kontakt" into a link that works under
// whichever base astro.config.mjs is set to build with.
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => base + path.replace(/^\//, "");

const navItems = [
  { href: "/nyheter", label: "Nyheter" },
  { href: "/skytebane", label: "Skytebane" },
  { href: "/terminliste", label: "Terminliste" },
];

const membershipMenu = [
  { href: "/sikkerhetskurs", label: "Sikkerhetskurs" },
  { href: "/vapensoknad", label: "Våpensøknad" },
];

const aboutMenu = [
  { href: "/om-klubben", label: "Om klubben" },
  { href: "/styreinfo", label: "Styreinfo" },
];

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(withBase(ogImage), Astro.site);
---

<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e7490" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="apple-touch-icon" href={withBase("/images/logo.png")} />
    <link rel="manifest" href={withBase("/site.webmanifest")} />
    <title>{title} · Hamar Pistolklubb</title>

    <!-- Display font matching the logo's blocky, tracked caps style -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800&display=swap" rel="stylesheet" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} · Hamar Pistolklubb`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="nb_NO" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Hamar Pistolklubb`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Hopp til innhold</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={base}>
          <Image class="logo" src={logoHorizontal} alt="Hamar Pistolklubb" width={4164} height={1037} />
        </a>

        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-nav"
          id="nav-toggle"
        >
          <span class="sr-only">Åpne meny</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>

        <nav aria-label="Hovedmeny" id="primary-nav">
          <ul class="nav-links">
            <li>
              <a href={base} aria-current={currentPath === base ? "page" : undefined}>
                Hjem
              </a>
            </li>
            {navItems.map((item) => (
              <li>
                <a
                  href={withBase(item.href)}
                  aria-current={currentPath === withBase(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li class="nav-dropdown">
              <button
                class="nav-dropdown-toggle"
                type="button"
                id="membership-menu-toggle"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="membership-menu"
                aria-current={membershipMenu.some((item) => withBase(item.href) === currentPath) ? "page" : undefined}
              >
                Medlemskap
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <ul class="nav-dropdown-menu" id="membership-menu" aria-labelledby="membership-menu-toggle">
                {membershipMenu.map((item) => (
                  <li>
                    <a
                      href={withBase(item.href)}
                      aria-current={currentPath === withBase(item.href) ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
            <li>
              <a href={withBase("/kontakt")} aria-current={currentPath === withBase("/kontakt") ? "page" : undefined}>
                Kontakt
              </a>
            </li>
            <li class="nav-dropdown">
              <button
                class="nav-dropdown-toggle"
                type="button"
                id="about-menu-toggle"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="about-menu"
                aria-current={aboutMenu.some((item) => withBase(item.href) === currentPath) ? "page" : undefined}
              >
                Om oss
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <ul class="nav-dropdown-menu" id="about-menu" aria-labelledby="about-menu-toggle">
                {aboutMenu.map((item) => (
                  <li>
                    <a
                      href={withBase(item.href)}
                      aria-current={currentPath === withBase(item.href) ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
            <li>
              <button
                class="search-toggle"
                type="button"
                id="search-toggle"
                aria-haspopup="dialog"
              >
                <span class="sr-only">Søk på nettsiden</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
              </button>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <slot name="hero" />

    <main class="container" id="main-content" transition:animate="fade">
      <slot />
    </main>

    {!hideSponsorStrip && (
      <section class="sponsor-strip">
        <div class="container">
          <h2>Samarbeidspartnere</h2>
          <div class="sponsor-logos">
            {sponsors.map((s) => (
              <a href={s.href} target="_blank" rel="noopener">
                {s.image ? <Image src={s.image} alt={s.name} width={320} /> : s.name}
                <span class="sr-only"> (åpnes i ny fane)</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <footer class="site-footer">
      <div class="container">
        <span>&copy; {new Date().getFullYear()} Hamar Pistolklubb</span>
        <a href="https://www.facebook.com/groups/423546947796062" target="_blank" rel="noopener">
          Facebook<span class="sr-only"> (åpnes i ny fane)</span>
        </a>
        <span class="footer-links">
          <a href={withBase("/kontakt")}>Kontakt oss</a>
        </span>
      </div>
    </footer>

    <div class="search-dialog" id="search-dialog" role="dialog" aria-modal="true" aria-label="Søk på nettsiden" hidden>
      <div class="search-backdrop" id="search-backdrop"></div>
      <div class="search-panel">
        <div class="search-field">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input
            type="search"
            id="search-input"
            placeholder="Søk på nettsiden…"
            autocomplete="off"
            aria-label="Søk på nettsiden"
          />
          <button type="button" id="search-close" class="search-close">
            <span class="sr-only">Lukk søk</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        </div>
        <ul class="search-results" id="search-results"></ul>
        <p class="search-empty" id="search-empty" hidden>Ingen treff.</p>
      </div>
    </div>

    <script>
      function closeMobileNav() {
        const toggle = document.getElementById("nav-toggle");
        const nav = document.getElementById("primary-nav");
        nav?.classList.remove("is-open");
        toggle?.setAttribute("aria-expanded", "false");
      }

      function initMobileNav() {
        const toggle = document.getElementById("nav-toggle");
        if (!toggle) return;

        toggle.onclick = () => {
          const nav = document.getElementById("primary-nav");
          if (!nav) return;
          const isOpen = nav.classList.toggle("is-open");
          toggle.setAttribute("aria-expanded", String(isOpen));
        };
      }

      initMobileNav();
      document.addEventListener("astro:page-load", () => {
        closeMobileNav();
        initMobileNav();
      });
    </script>

    <script>
      // Nav dropdowns ("Medlemskap"): toggle on click, close on
      // Escape, outside click, or navigation (re-bound on astro:page-load
      // for view transitions).
      function initDropdown(toggleId: string, menuId: string) {
        const toggle = document.getElementById(toggleId);
        const menu = document.getElementById(menuId);
        if (!toggle || !menu) return;

        function close() {
          toggle!.setAttribute("aria-expanded", "false");
          menu!.classList.remove("is-open");
        }

        function open() {
          toggle!.setAttribute("aria-expanded", "true");
          menu!.classList.add("is-open");
        }

        toggle.addEventListener("click", (event) => {
          event.stopPropagation();
          const isOpen = toggle.getAttribute("aria-expanded") === "true";
          if (isOpen) close();
          else open();
        });

        document.addEventListener("click", (event) => {
          if (!menu.contains(event.target as Node) && event.target !== toggle) close();
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") close();
        });

        document.addEventListener("astro:page-load", close);
      }

      initDropdown("membership-menu-toggle", "membership-menu");
      initDropdown("about-menu-toggle", "about-menu");
      document.addEventListener("astro:page-load", () => {
        initDropdown("membership-menu-toggle", "membership-menu");
        initDropdown("about-menu-toggle", "about-menu");
      });
    </script>

    <script>
      // Lightweight site search: fetches a prebuilt JSON index once, then
      // filters client-side. Works across full page loads and Astro's
      // client-side view transitions (re-bound on astro:page-load).
      type SearchEntry = { url: string; title: string; text: string };

      let index: SearchEntry[] | null = null;
      let lastFocused: HTMLElement | null = null;

      async function loadIndex() {
        if (index) return index;
        const res = await fetch(`${import.meta.env.BASE_URL}search.json`);
        index = (await res.json()) as SearchEntry[];
        return index;
      }

      function excerpt(text: string, query: string, length = 100) {
        const lower = text.toLowerCase();
        const at = lower.indexOf(query.toLowerCase());
        if (at === -1) return text.slice(0, length);
        const start = Math.max(0, at - 30);
        return `${start > 0 ? "…" : ""}${text.slice(start, start + length)}…`;
      }

      function initSearch() {
        const dialog = document.getElementById("search-dialog");
        const backdrop = document.getElementById("search-backdrop");
        const openBtn = document.getElementById("search-toggle");
        const closeBtn = document.getElementById("search-close");
        const input = document.getElementById("search-input") as HTMLInputElement | null;
        const results = document.getElementById("search-results");
        const empty = document.getElementById("search-empty");
        if (!dialog || !openBtn || !input || !results) return;

        async function open() {
          lastFocused = document.activeElement as HTMLElement | null;
          dialog!.hidden = false;
          document.body.style.overflow = "hidden";
          input!.value = "";
          results!.innerHTML = "";
          if (empty) empty.hidden = true;
          input!.focus();
          await loadIndex();
        }

        function close() {
          dialog!.hidden = true;
          document.body.style.overflow = "";
          lastFocused?.focus();
        }

        openBtn.addEventListener("click", open);
        closeBtn?.addEventListener("click", close);
        backdrop?.addEventListener("click", close);

        document.addEventListener("keydown", (event) => {
          if (event.key === "/" && dialog!.hidden && document.activeElement?.tagName !== "INPUT") {
            event.preventDefault();
            open();
          } else if (event.key === "Escape" && !dialog!.hidden) {
            close();
          }
        });

        input.addEventListener("input", async () => {
          const query = input.value.trim();
          if (!query) {
            results!.innerHTML = "";
            if (empty) empty.hidden = true;
            return;
          }

          const entries = await loadIndex();
          const words = query.toLowerCase().split(/\s+/).filter(Boolean);
          const matches = entries
            .filter((entry) => {
              const haystack = `${entry.title} ${entry.text}`.toLowerCase();
              return words.every((word) => haystack.includes(word));
            })
            .slice(0, 8);

          if (empty) empty.hidden = matches.length !== 0;

          // Built with DOM APIs (not innerHTML + template string) so
          // untrusted content - e.g. a news post title/body authored by a
          // non-technical editor via the GitHub web UI - can never be
          // interpreted as HTML, only ever inserted as plain text.
          results!.replaceChildren(
            ...matches.map((entry) => {
              const li = document.createElement("li");
              const link = document.createElement("a");
              link.href = entry.url;

              const title = document.createElement("span");
              title.className = "search-result-title";
              title.textContent = entry.title;

              const excerptEl = document.createElement("span");
              excerptEl.className = "search-result-excerpt";
              excerptEl.textContent = excerpt(entry.text, query);

              link.append(title, excerptEl);
              li.append(link);
              return li;
            })
          );
        });
      }

      initSearch();
      document.addEventListener("astro:page-load", initSearch);
    </script>
  </body>
</html>
